<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModList</AssemblyName>
    <RootNamespace>ModList</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>libs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>libs\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(GameDir)' != '' And Exists('$(GameDir)')">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\ModList" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Thunderstore\manifest.json'))</ManifestText>
      <ModName>$([System.Text.RegularExpressions.Regex]::Replace($(ManifestText), '^[\s\S]*?"name"\s*:\s*"([^"]+)"[\s\S]*$', '$1'))</ModName>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Replace($(ManifestText), '^[\s\S]*?"version_number"\s*:\s*"([^"]+)"[\s\S]*$', '$1'))</ModVersion>
      <PackageName>SlotsAndDaggers$(ModName)-$(ModVersion)</PackageName>
      <DistDir>$(MSBuildProjectDirectory)\dist</DistDir>
      <StageDir>$(DistDir)\stage</StageDir>
      <ZipPath>$(DistDir)\$(PackageName).zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <ItemGroup>
      <PackageDll Include="$(OutDir)*.dll" />
      <PackageMeta Include="$(MSBuildProjectDirectory)\Thunderstore\manifest.json;$(MSBuildProjectDirectory)\Thunderstore\README.md;$(MSBuildProjectDirectory)\Thunderstore\CHANGELOG.md;$(MSBuildProjectDirectory)\Thunderstore\icon.png" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageDll);@(PackageMeta)" DestinationFolder="$(StageDir)" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(StageDir)" />
    <Message Importance="high" Text="Thunderstore package created: $(ZipPath)" />
  </Target>

</Project>
